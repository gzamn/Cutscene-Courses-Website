{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about registered students and instructors",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "instructor", "admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Course": {
      "title": "Course",
      "description": "Academy course details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "detailedDescription": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "image": { "type": "string" },
        "duration": { "type": "string" },
        "level": { "type": "string" },
        "instructor": { "type": "object" },
        "chapters": { "type": "array" },
        "isComingSoon": { "type": "boolean" }
      },
      "required": ["id", "title", "price"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "User enrollment status in courses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "courseId": { "type": "string" },
        "enrolledAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["uid", "courseId"]
    },
    "Progress": {
      "title": "Progress",
      "description": "Tracking student lesson completions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "courseId": { "type": "string" },
        "chapter": { "type": "string" },
        "type": { "type": "string" },
        "completed": { "type": "boolean" },
        "currentTime": { "type": "number" },
        "duration": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "courseId", "chapter", "type"]
    },
    "Review": {
      "title": "Review",
      "description": "Course reviews and ratings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "courseId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "userName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "courseId", "rating"]
    },
    "Certificate": {
      "title": "Certificate",
      "description": "Earned dynamic course completion certificates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "userName": { "type": "string" },
        "issuedAt": { "type": "string" }
      },
      "required": ["uid", "courseId"]
    },
    "Submission": {
      "title": "Homework Submission",
      "description": "Student homework uploads and links",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "courseId": { "type": "string" },
        "chapterTitle": { "type": "string" },
        "githubUrl": { "type": "string" },
        "notionUrl": { "type": "string" },
        "imageUrls": { "type": "array" },
        "comment": { "type": "string" },
        "submittedAt": { "type": "string" }
      },
      "required": ["uid", "courseId"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Course or video player discussion comments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "chapter": { "type": "number" },
        "uid": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["courseId", "chapter", "uid", "content"]
    },
    "Chapter": {
      "title": "Course Chapter",
      "description": "Detailed chapter and learning links under a course",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "position": { "type": "number" },
        "is_preview": { "type": "boolean" },
        "session_url": { "type": "string" },
        "exercise_url": { "type": "string" },
        "homework_url": { "type": "string" }
      },
      "required": ["title", "position"]
    },
    "StudentWork": {
      "title": "Student Work Showcase",
      "description": "Information about exceptional student projects to display on the home page",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentName": { "type": "string" },
        "thumbnail": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" }
      },
      "required": ["studentName", "thumbnail", "courseId", "courseTitle"]
    },
    "StoreProduct": {
      "title": "Store Product",
      "description": "Products representing software subscriptions and services",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "durations": { "type": "object" },
        "durationKeysOrder": { "type": "array" },
        "defaultDuration": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "description", "durations"]
    },
    "StorePurchase": {
      "title": "Store Purchase",
      "description": "Store product purchase requests and status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "duration": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "receiptUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "rejectionReason": { "type": "string" },
        "submittedAt": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "activeUntil": { "type": "string" }
      },
      "required": ["uid", "productId", "productName", "duration", "price", "receiptUrl", "status", "submittedAt"]
    },
    "UsefulResource": {
      "title": "Useful Resource",
      "description": "Curated links to external resources",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "logoUrl": { "type": "string" },
        "url": { "type": "string" },
        "order": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "url", "category"]
    },
    "Plan": {
      "title": "Membership Plan",
      "description": "Membership bundles and subscription plans",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "string" },
        "description": { "type": "string" },
        "features": { "type": "array" },
        "isPopular": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["name", "price"]
    },
    "HeroVideo": {
      "title": "Hero Video",
      "description": "Homepage background hero/intro video references",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "videoUrl": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "videoUrl"]
    },
    "Update": {
      "title": "Update or Announcement",
      "description": "Latest announcements and news posted by admins",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "pinned": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["title", "content", "createdAt"]
    },
    "SpecialOffer": {
      "title": "Special Offer Bundle",
      "description": "Combination of academy courses with a lowered promotional price",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titleEn": { "type": "string" },
        "titleFr": { "type": "string" },
        "titleAr": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "descriptionFr": { "type": "string" },
        "descriptionAr": { "type": "string" },
        "courseIds": { "type": "array" },
        "originalPrice": { "type": "number" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "imageUrl": { "type": "string" },
        "badgeEn": { "type": "string" },
        "badgeFr": { "type": "string" },
        "badgeAr": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "titleEn", "courseIds", "originalPrice", "price", "currency"]
    },
    "Statistic": {
      "title": "Academy Statistic",
      "description": "Dynamic homepage statistics section parameters editable by admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "value": { "type": "string" },
        "labelEn": { "type": "string" },
        "labelFr": { "type": "string" },
        "labelAr": { "type": "string" },
        "iconName": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "value", "labelEn", "order"]
    },
    "ResourceTrigger": {
      "title": "Resource Notification Trigger",
      "description": "Auto-pop a resource highlighting contour or full-screen notification at a specific video time",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "chapter": { "type": "string" },
        "type": { "type": "string" },
        "timeInSeconds": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["courseId", "chapter", "type", "timeInSeconds"]
    },
    "Region": {
      "title": "Region Configuration",
      "description": "Country or continent specific pricing, multiplier and payment methods",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "currency": { "type": "string" },
        "symbol": { "type": "string" },
        "multiplier": { "type": "number" },
        "paymentMethods": { "type": "array" },
        "overrides": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "currency", "symbol", "multiplier"]
    },
    "UserVideo": {
      "title": "User Video",
      "description": "User uploaded/recorded videos",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "title", "url"]
    },
    "UserDownload": {
      "title": "User Download",
      "description": "User saved downloadable files",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "downloadableId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "description": { "type": "string" },
        "savedAt": { "type": "string" }
      },
      "required": ["uid", "downloadableId", "name", "downloadUrl"]
    },
    "ShippedAccount": {
      "title": "Shipped Account",
      "description": "Access credentials for Adobe Creative Cloud or course accounts entered by Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "shippedAt": { "type": "string" }
      },
      "required": ["uid", "email", "password", "productId", "productName"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Direct user records"
    },
    "courses/{courseId}": {
      "schema": "Course",
      "description": "Course documents"
    },
    "courses/{courseId}/chapters/{chapterId}": {
      "schema": "Chapter",
      "description": "Chapters subcollection under courses"
    },
    "enrollments/{enrollmentId}": {
      "schema": "Enrollment",
      "description": "User enrollments"
    },
    "progress/{progressId}": {
      "schema": "Progress",
      "description": "User learning progress records"
    },
    "reviews/{reviewId}": {
      "schema": "Review",
      "description": "Course feedback and stars"
    },
    "certificates/{certificateId}": {
      "schema": "Certificate",
      "description": "Achievement certifications"
    },
    "homework_submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Uploaded exercise assignments"
    },
    "comments/{commentId}": {
      "schema": "Comment",
      "description": "Discussion postings"
    },
    "student_works/{workId}": {
      "schema": "StudentWork",
      "description": "Students' project showcase items"
    },
    "store_products/{productId}": {
      "schema": "StoreProduct",
      "description": "Dynamic store products for subscriptions/digital services"
    },
    "store_purchases/{purchaseId}": {
      "schema": "StorePurchase",
      "description": "Store purchase subscription receipts for verification"
    },
    "useful_resources/{resourceId}": {
      "schema": "UsefulResource",
      "description": "Curated external categorized links"
    },
    "plans/{planId}": {
      "schema": "Plan",
      "description": "Subscription and membership bundles"
    },
    "hero_videos/{videoId}": {
      "schema": "HeroVideo",
      "description": "Homepage background hero/intro video references"
    },
    "updates/{updateId}": {
      "schema": "Update",
      "description": "Announcements and site news posted by admins"
    },
    "special_offers/{offerId}": {
      "schema": "SpecialOffer",
      "description": "Combination of academy courses at a promotional lower price"
    },
    "statistics/{statisticId}": {
      "schema": "Statistic",
      "description": "Dynamic homepage statistics section parameters editable by admin"
    },
    "resource_triggers/{triggerId}": {
      "schema": "ResourceTrigger",
      "description": "Resource notification triggers for video player"
    },
    "regions/{regionId}": {
      "schema": "Region",
      "description": "Region configuration documents"
    },
    "videos/{videoId}": {
      "schema": "UserVideo",
      "description": "User uploaded/recorded videos"
    },
    "user_downloads/{downloadId}": {
      "schema": "UserDownload",
      "description": "User saved downloadable files"
    },
    "shipped_accounts/{accountId}": {
      "schema": "ShippedAccount",
      "description": "Access credentials for student purchases of courses or Creative Cloud"
    }
  }
}
