{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about registered students and instructors",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "instructor", "admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Course": {
      "title": "Course",
      "description": "Academy course details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "detailedDescription": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "image": { "type": "string" },
        "duration": { "type": "string" },
        "level": { "type": "string" },
        "instructor": { "type": "object" },
        "chapters": { "type": "array" }
      },
      "required": ["id", "title", "price"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "User enrollment status in courses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "courseId": { "type": "string" },
        "enrolledAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["uid", "courseId"]
    },
    "Progress": {
      "title": "Progress",
      "description": "Tracking student lesson completions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "courseId": { "type": "string" },
        "chapter": { "type": "string" },
        "type": { "type": "string" },
        "completed": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "courseId", "chapter", "type"]
    },
    "Review": {
      "title": "Review",
      "description": "Course reviews and ratings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "courseId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "userName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "courseId", "rating"]
    },
    "Certificate": {
      "title": "Certificate",
      "description": "Earned dynamic course completion certificates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "userName": { "type": "string" },
        "issuedAt": { "type": "string" }
      },
      "required": ["uid", "courseId"]
    },
    "Submission": {
      "title": "Homework Submission",
      "description": "Student homework uploads and links",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "courseId": { "type": "string" },
        "chapterTitle": { "type": "string" },
        "githubUrl": { "type": "string" },
        "notionUrl": { "type": "string" },
        "imageUrls": { "type": "array" },
        "comment": { "type": "string" },
        "submittedAt": { "type": "string" }
      },
      "required": ["uid", "courseId"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Course or video player discussion comments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "chapter": { "type": "string" },
        "user": { "type": "object" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["courseId", "text", "user"]
    },
    "Chapter": {
      "title": "Course Chapter",
      "description": "Detailed chapter and learning links under a course",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "position": { "type": "number" },
        "is_preview": { "type": "boolean" },
        "session_url": { "type": "string" },
        "exercise_url": { "type": "string" },
        "homework_url": { "type": "string" }
      },
      "required": ["title", "position"]
    },
    "StudentWork": {
      "title": "Student Work Showcase",
      "description": "Information about exceptional student projects to display on the home page",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentName": { "type": "string" },
        "thumbnail": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" }
      },
      "required": ["studentName", "thumbnail", "courseId", "courseTitle"]
    },
    "Downloadable": {
      "title": "Downloadable Asset",
      "description": "Premium downloadable asset",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["Softwares", "Videos", "Images", "Music", "Sound Effects"] },
        "imageUrl": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "category", "downloadUrl"]
    },
    "Plan": {
      "title": "Membership Plan",
      "description": "Membership bundles and subscription plans",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "string" },
        "description": { "type": "string" },
        "features": { "type": "array" },
        "isPopular": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["name", "price"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Direct user records"
    },
    "courses/{courseId}": {
      "schema": "Course",
      "description": "Course documents"
    },
    "courses/{courseId}/chapters/{chapterId}": {
      "schema": "Chapter",
      "description": "Chapters subcollection under courses"
    },
    "enrollments/{enrollmentId}": {
      "schema": "Enrollment",
      "description": "User enrollments"
    },
    "progress/{progressId}": {
      "schema": "Progress",
      "description": "User learning progress records"
    },
    "reviews/{reviewId}": {
      "schema": "Review",
      "description": "Course feedback and stars"
    },
    "certificates/{certificateId}": {
      "schema": "Certificate",
      "description": "Achievement certifications"
    },
    "homework_submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Uploaded exercise assignments"
    },
    "comments/{commentId}": {
      "schema": "Comment",
      "description": "Discussion postings"
    },
    "student_works/{workId}": {
      "schema": "StudentWork",
      "description": "Students' project showcase items"
    },
    "downloadables/{downloadableId}": {
      "schema": "Downloadable",
      "description": "Available downloadable assets for premium students"
    },
    "plans/{planId}": {
      "schema": "Plan",
      "description": "Subscription and membership bundles"
    }
  }
}
