rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Identity & Role Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.keys().contains('email') && 
         request.auth.token.email.matches('(?i)^aminerouabhia14@gmail\\.com$')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users (Student/Instructor Profiles)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isOwner(userId) && request.resource.data.uid == userId);
    }

    // Courses Metadata
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      // Chapters Subcollection under Courses
      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Dynamic Course enrollments mapping
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Student Video/Chapters Progress Metrics
    match /progress/{progressId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Course Feedback & Stars reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Course completion digital certificates
    match /certificates/{certificateId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Uploaded Exercises Submissions
    match /homework_submissions/{submissionId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Inter-Student lesson discussion comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Students' project showcase items
    match /student_works/{workId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.student_id == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.student_id == request.auth.uid);
    }

    // Downloadables collection
    match /downloadables/{downloadableId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Membership plans collection
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Hero background videos collection
    match /hero_videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Config parameters
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Latest Updates & News Announcements
    match /updates/{updateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Special promotional bundle offers
    match /special_offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Homepage achievement statistics
    match /statistics/{statisticId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Resource notification triggers
    match /resource_triggers/{triggerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Region configuration collection
    match /regions/{regionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
